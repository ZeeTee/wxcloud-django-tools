# 复制为 .env 后填入真实值。.env 不要提交到仓库。
# 云托管部署时不用这个文件，直接在控制台「服务设置 → 环境变量」里配。

# ---- 模型 provider（切换用）----
# 可选 deepseek（默认）或 openrouter。切换时只改这一行，两个 key 可以同时配好。
LLM_PROVIDER=deepseek

# DeepSeek 官方（provider=deepseek 时使用）
DEEPSEEK_API_KEY=sk-请替换成你的密钥

# OpenRouter（provider=openrouter 时使用）
OPENROUTER_API_KEY=sk-or-v1-请替换成你的密钥
# OpenRouter 建议带上来源信息（用于它的应用排名），可选
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=deai-wechat

# 兼容旧配置：上面两个 provider 专属 key 都没配时会回退读这个
LLM_API_KEY=

# 以下两项留空则用所选 provider 的默认值：
#   deepseek   -> https://api.deepseek.com/v1 + deepseek-chat
#   openrouter -> https://openrouter.ai/api/v1 + deepseek/deepseek-chat
LLM_BASE_URL=
LLM_MODEL=
# 秒。必须小于 gunicorn 的 --timeout(55) 和平台上限 60
LLM_TIMEOUT=50

# ---- 模型定价（元 / 百万 token）----
# 只在**供应商不返回 cost** 时才用到（DeepSeek 属于这种，OpenRouter 会直接返回美元成本）。
# 默认取 DeepSeek 的**高峰时段价**（宁可高估不要低估）。
# DeepSeek 空闲时段（周末、法定节假日、工作日 9-12 点与 14-18 点之外）是高峰价的一半。
# 注意：缓存命中价与未命中价差 50 倍，而 humanizer 的 system prompt 固定不变，
# 实测直连 DeepSeek 时缓存命中率约 96%，所以 LLM_PRICE_CACHE_IN 对总成本影响很大。
LLM_PRICE_CACHE_IN=0.04
LLM_PRICE_IN=2.0
LLM_PRICE_OUT=8.0

# OpenRouter 直接返回美元成本，按这个汇率折成人民币入库与展示
USD_CNY_RATE=7.2

# ---- Django ----
# 生产必须换成随机串：python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

# ---- 业务 ----
DEAI_MAX_INPUT_CHARS=5000
# 每人每天可用的 AI 深度改写次数（规则层体检与秒改不限次）。
# 身份用的是云托管自动注入的 X-WX-OPENID，不是前端本地存储——存本地的话
# 用户清一次缓存就重置了，等于没有限制。一个人 = 一个 openid。
# 按北京时间自然日归零，不需要定时任务。
DEAI_DAILY_QUOTA=10
# ⚠️ 下面这些名字**已经废弃、代码不再读取**，环境变量里如果还留着请删掉：
#    DEAI_DAILY_LIMIT                 一配就同时覆盖两档，而且是静默的
#    DEAI_DAILY_LIMIT_ANONYMOUS       两档时代的未授权档
#    DEAI_DAILY_LIMIT_VERIFIED        两档时代的已授权档
# 这里刻意不把它们写成可复制的赋值——写出来就会有人照着配，正是当初踩坑的原因。

# ---- 微信小程序手机号授权（可选，不影响使用次数）----
# 在微信公众平台 → 开发管理 → 开发设置 里获取。
# 注意：手机号授权要按次付费且只对非个人主体开放，次数已经不靠它区分了，
# 除非确实需要手机号，否则可以不配、也不要在界面上放入口。
WX_APPID=
WX_SECRET=
WX_LOGIN_TIMEOUT=10
# 超过这个秒数仍无结果的任务判为失败
DEAI_TASK_TIMEOUT_SECONDS=120
DEAI_WORKERS=4
# 混合模式：创建任务后同步等待几秒，等到了就直接返回结果，超时才转前端轮询。
# 实测一次改写 0.5-2.3 秒，12 秒足够；上限是 callContainer 的 15 秒。设 0 = 纯异步。
DEAI_SYNC_WAIT_SECONDS=12
# 只有本地开发才设 true；生产保持 false，强制走微信身份
DEAI_ALLOW_ANONYMOUS=false

# ---- 数据库 ----
# 不配就是 SQLite（<项目根>/data/deai.sqlite3），本地开发不用装 MySQL。
# 云托管里开通 MySQL 后会自动注入 MYSQL_ADDRESS / MYSQL_USERNAME / MYSQL_PASSWORD。
# MYSQL_ADDRESS=10.0.0.1:3306
# MYSQL_DATABASE=django_demo
# MYSQL_USERNAME=root
# MYSQL_USER=root
# MYSQL_PASSWORD=
# SQLITE_PATH=/app/data/deai.sqlite3
