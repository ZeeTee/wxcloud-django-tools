/* app.wxss —— 全局设计语言
 * 主色：墨绿 #14453D / #1F6F5C（沉稳，不用紫渐变）
 * 圆角：卡片 24rpx，按钮 20rpx，小标签 999rpx
 * 所有页面底部统一留出 iPhone 安全区
 */

page {
  background: #F4F6F5;
  color: #1B211F;
  font-size: 28rpx;
  line-height: 1.65;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, textarea, button, input {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 0;
}

.page-bottom {
  /* 底部安全区适配：iPhone 刘海屏 home indicator */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 69, 61, 0.05);
}

.card-flat {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #E6EBE9;
}

/* ---------- 文字层级 ---------- */
.t-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #14453D;
  line-height: 1.35;
}

.t-sub {
  font-size: 26rpx;
  color: #5E6E69;
}

.t-h2 {
  font-size: 32rpx;
  font-weight: 600;
  color: #1B211F;
}

.t-small {
  font-size: 24rpx;
  color: #93A19C;
}

.t-strong {
  font-weight: 600;
  color: #1B211F;
}

.mono-num {
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  padding: 0 32rpx;
  margin: 0;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #14453D;
  color: #FFFFFF;
}

.btn-primary.btn-off {
  background: #B9C7C2;
  color: #F2F6F5;
}

.btn-ghost {
  background: #E7F0ED;
  color: #14453D;
}

.btn-ghost.btn-off {
  background: #EFF2F1;
  color: #AEBBB6;
}

.btn-line {
  background: #FFFFFF;
  color: #14453D;
  border: 2rpx solid #CFDDD8;
}

.btn-mini {
  height: 64rpx;
  font-size: 26rpx;
  border-radius: 14rpx;
  padding: 0 24rpx;
}

.btn[disabled] {
  opacity: 0.55;
}

/* ---------- 标签 / 徽标 ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.chip-high {
  background: #FBE9E7;
  color: #C6483F;
}

.chip-medium {
  background: #FCF1DF;
  color: #A9660F;
}

.chip-low {
  background: #E7F0ED;
  color: #2E7D68;
}

.chip-brand {
  background: #E7F0ED;
  color: #14453D;
}

/* ---------- 命中高亮（原文 tab 用） ---------- */
.hl {
  border-radius: 6rpx;
  padding: 0 2rpx;
}

.hl-high {
  background: #FBD9D5;
  color: #8E2B22;
}

.hl-medium {
  background: #FBE7C6;
  color: #85530A;
}

.hl-low {
  background: #DDEDE7;
  color: #1F5E4E;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #93A19C;
  font-size: 26rpx;
}

/* ---------- 通用行 ---------- */
.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gap-8 { height: 8rpx; }
.gap-16 { height: 16rpx; }
.gap-24 { height: 24rpx; }

.divider {
  height: 2rpx;
  background: #EDF1F0;
  margin: 24rpx 0;
}
