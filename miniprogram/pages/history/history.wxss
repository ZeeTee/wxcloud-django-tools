/* pages/history/history.wxss */

.hd {
  padding: 12rpx 8rpx 26rpx;
}

.hd-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #14453D;
}

.hd-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #93A19C;
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.item-hover {
  background: #F7FAF9;
}

.score-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.item-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.item-summary {
  font-size: 28rpx;
  color: #1B211F;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #93A19C;
}

.item-del {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #F5F7F6;
  color: #93A19C;
  font-size: 24rpx;
}

.empty-box {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 70rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(20, 69, 61, 0.05);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1B211F;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #93A19C;
  line-height: 1.6;
}

.clear-wrap {
  margin-top: 16rpx;
}
