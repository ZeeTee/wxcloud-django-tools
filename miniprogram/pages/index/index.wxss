/* pages/index/index.wxss */

.hero {
  padding: 16rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #14453D;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5E6E69;
  line-height: 1.6;
}

/* ---------- 配置提示 ---------- */
.notice-card {
  background: #FCF1DF;
  box-shadow: none;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #8A560F;
}

.notice-body {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #A9660F;
  line-height: 1.6;
}

/* ---------- 未完成任务 ---------- */
.pending-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #E7F0ED;
  box-shadow: none;
}

.pending-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.pending-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #14453D;
}

.pending-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #4E6A62;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pending-ops {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.pending-drop {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #6E837C;
  padding: 12rpx 4rpx;
}

/* ---------- 编辑器 ---------- */
.editor-card {
  padding: 20rpx 20rpx 8rpx;
}

.editor {
  width: 100%;
  height: 420rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #1B211F;
  padding: 12rpx;
}

.editor-ph {
  color: #A9B5B1;
  font-size: 28rpx;
  line-height: 1.7;
}

.editor-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid #EDF1F0;
  padding: 14rpx 4rpx 8rpx;
  margin-top: 8rpx;
}

.toolbar {
  display: flex;
  align-items: center;
}

.tool {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 26rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background: #F1F5F4;
  color: #34524A;
  font-size: 26rpx;
}

.tool-hover {
  background: #E1EAE7;
}

.counter {
  font-size: 26rpx;
  color: #93A19C;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  padding-right: 8rpx;
}

.counter-over {
  color: #C6483F;
  font-weight: 600;
}

.hint-line {
  padding: 0 12rpx 20rpx;
  font-size: 24rpx;
  color: #93A19C;
}

.hint-danger {
  color: #C6483F;
}

/* ---------- 模式 ---------- */
.mode-block {
  padding: 0 8rpx 28rpx;
}

.mode-label {
  font-size: 26rpx;
  color: #5E6E69;
  margin-bottom: 14rpx;
}

.seg {
  display: flex;
  background: #E9EEEC;
  border-radius: 18rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5E6E69;
  border-radius: 14rpx;
  transition: all 0.15s ease;
}

.seg-on {
  background: #FFFFFF;
  color: #14453D;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(20, 69, 61, 0.08);
}

.mode-tip {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #93A19C;
}

/* ---------- 主操作 ---------- */
.actions {
  padding: 0 8rpx;
}

/* ---------- 底部 ---------- */
.foot {
  margin-top: 40rpx;
  padding: 0 8rpx;
}

.quota {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #5E6E69;
}

.quota-refresh {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #1F6F5C;
  text-decoration: underline;
}

.quota-empty {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #C6483F;
  line-height: 1.6;
}

.foot-links {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 20rpx;
}

.link {
  font-size: 26rpx;
  color: #14453D;
  padding: 8rpx 12rpx;
}

.link-dot {
  color: #C3CDCA;
  font-size: 24rpx;
}
