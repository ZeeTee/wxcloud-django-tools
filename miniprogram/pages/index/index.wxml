<!-- pages/index/index.wxml -->
<view class="page page-bottom">

  <!-- 价值主张 -->
  <view class="hero">
    <view class="hero-title">把 AI 腔，改回人话</view>
    <view class="hero-sub">粘贴一段疑似 AI 写的中文，先出一份「AI 味体检报告」，再重写成正常说话的样子。</view>
  </view>

  <!-- 配置自检 -->
  <view class="card notice-card" wx:if="{{!configured}}">
    <view class="notice-title">还差一步配置</view>
    <view class="notice-body">{{configHint}}</view>
    <view class="notice-body mono">miniprogram/config.js → CLOUD_ENV / SERVICE_NAME</view>
  </view>

  <!-- 有没看完的 AI 改写任务 -->
  <view class="card pending-card" wx:if="{{pending}}">
    <view class="pending-main">
      <view class="pending-title">有一次 AI 改写还没看完</view>
      <view class="pending-sub">{{pendingSummary}}…</view>
    </view>
    <view class="pending-ops">
      <view class="btn btn-mini btn-ghost" bindtap="onResumePending">继续查看</view>
      <view class="pending-drop" bindtap="onDismissPending">忽略</view>
    </view>
  </view>

  <!-- 输入 -->
  <view class="card editor-card">
    <textarea
      class="editor"
      value="{{text}}"
      bindinput="onInput"
      maxlength="-1"
      placeholder="把那段读起来像 AI 写的中文粘进来，5000 字以内"
      placeholder-class="editor-ph"
      show-confirm-bar="{{false}}"
      cursor-spacing="32"
      adjust-position="{{true}}"
    ></textarea>

    <view class="editor-foot">
      <view class="toolbar">
        <view class="tool" hover-class="tool-hover" bindtap="onPaste">粘贴</view>
        <view class="tool" hover-class="tool-hover" bindtap="onSample">示例</view>
        <view class="tool" hover-class="tool-hover" bindtap="onClear">清空</view>
      </view>
      <view class="counter {{over ? 'counter-over' : ''}}">{{charCount}}/{{maxChars}}</view>
    </view>
  </view>

  <view class="hint-line" wx:if="{{charCount === 0}}">先粘贴一段文字，或点「示例」试试</view>
  <view class="hint-line hint-danger" wx:if="{{over}}">超过 {{maxChars}} 字了，删掉一些再提交</view>

  <!-- 模式 -->
  <view class="mode-block">
    <view class="mode-label">改写模式</view>
    <view class="seg">
      <view class="seg-item {{mode === 'general' ? 'seg-on' : ''}}" data-mode="general" bindtap="onMode">通用</view>
      <view class="seg-item {{mode === 'xhs' ? 'seg-on' : ''}}" data-mode="xhs" bindtap="onMode">小红书</view>
    </view>
    <view class="mode-tip">{{mode === 'xhs' ? '口语、短句、可以直接发笔记' : '不改变文体，只去掉机器腔和套话'}}</view>
  </view>

  <!-- 主操作 -->
  <view class="actions">
    <button
      class="btn btn-primary {{canSubmit ? '' : 'btn-off'}}"
      bindtap="onRewrite"
      disabled="{{btnDisabled}}"
      loading="{{submittingAction === 'rewrite'}}"
    >深度改写（AI）</button>

    <view class="gap-16"></view>

    <button
      class="btn btn-line {{canSubmit ? '' : 'btn-off'}}"
      bindtap="onAnalyze"
      disabled="{{btnDisabled}}"
      loading="{{submittingAction === 'analyze'}}"
    >只做体检 + 规则改写（秒出）</button>
  </view>

  <!-- 底部：剩余次数 + 入口 -->
  <view class="foot">
    <view class="quota" bindtap="onRefreshQuota">
      <text>{{quotaText}}</text>
      <text class="quota-refresh">刷新</text>
    </view>
    <view class="quota-empty" wx:if="{{quotaEmpty}}" bindtap="onAbout">今天的次数用完了，明天自动恢复。点这里看说明 ›</view>
    <view class="foot-links">
      <text class="link" bindtap="onHistory">历史记录</text>
      <text class="link-dot">·</text>
      <text class="link" bindtap="onAbout">关于</text>
    </view>
  </view>
</view>
