/* pages/result/result.wxss */

/* ---------- 顶部概览 ---------- */
.head-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.donut {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E4EAE8;
  background: conic-gradient(var(--c) 0turn, var(--c) var(--p), #E4EAE8 var(--p), #E4EAE8 1turn);
}

.donut-hole {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.donut-num {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.donut-unit {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #93A19C;
}

.head-info {
  flex: 1;
  min-width: 0;
  padding-left: 28rpx;
}

.head-chips {
  display: flex;
  align-items: center;
}

.head-chips .chip {
  margin-right: 12rpx;
}

.head-verdict {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1B211F;
  line-height: 1.4;
}

.head-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #93A19C;
}

/* ---------- Tabs ---------- */
.tabs {
  display: flex;
  background: #E9EEEC;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 74rpx;
  line-height: 74rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5E6E69;
  border-radius: 14rpx;
}

.tab-on {
  background: #FFFFFF;
  color: #14453D;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(20, 69, 61, 0.08);
}

/* ---------- 进行中 ---------- */
.progress-card {
  background: #14453D;
  box-shadow: none;
}

.progress-head {
  display: flex;
  align-items: center;
}

.pulse {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #7FD3B8;
  margin-right: 14rpx;
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0% { transform: scale(0.7); opacity: 0.5; }
  50% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(0.7); opacity: 0.5; }
}

.progress-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.progress-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9FC3B8;
}

.skeleton {
  margin-top: 26rpx;
}

.sk-line {
  height: 22rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.28) 50%, rgba(255, 255, 255, 0.12) 100%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

.sk-90 { width: 90%; }
.sk-85 { width: 85%; }
.sk-75 { width: 75%; }
.sk-60 { width: 60%; }

@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

.progress-note {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #9FC3B8;
}

/* ---------- 失败 ---------- */
.error-card {
  background: #FBE9E7;
  box-shadow: none;
}

.error-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #A63A31;
}

.error-body {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #B4554B;
  line-height: 1.6;
}

.error-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #B98A83;
}

.error-ops {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
}

.error-about {
  margin-left: 24rpx;
  font-size: 25rpx;
  color: #A63A31;
  text-decoration: underline;
}

/* ---------- AI 版 / 规则版 ---------- */
.switch {
  display: flex;
  margin-bottom: 24rpx;
}

.switch-item {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #5E6E69;
  background: #FFFFFF;
  border: 2rpx solid #E1E8E6;
}

.switch-on {
  background: #14453D;
  border-color: #14453D;
  color: #FFFFFF;
  font-weight: 600;
}

/* ---------- 正文 ---------- */
.text-card {
  padding-bottom: 32rpx;
}

.text-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #EDF1F0;
  margin-bottom: 22rpx;
}

.text-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #14453D;
}

.text-head-right {
  display: flex;
  align-items: center;
}

.text-count {
  font-size: 23rpx;
  color: #93A19C;
  margin-right: 18rpx;
}

.copy-mini {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #E7F0ED;
  color: #14453D;
  font-size: 24rpx;
}

.text-body {
  font-size: 31rpx;
  line-height: 1.85;
  color: #232A28;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---------- 操作 ---------- */
.action-bar {
  margin-top: 8rpx;
}

.action-tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #93A19C;
  line-height: 1.6;
  padding: 0 8rpx;
}

/* ---------- 体检报告 ---------- */
.verdict-card {
  background: #E7F0ED;
  box-shadow: none;
}

.verdict-text {
  font-size: 27rpx;
  color: #14453D;
  line-height: 1.7;
  font-weight: 500;
}

.advice-item {
  font-size: 26rpx;
  color: #3F4A47;
  line-height: 1.75;
  padding-left: 26rpx;
  position: relative;
  margin-bottom: 10rpx;
}

.advice-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1F6F5C;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1B211F;
  margin-bottom: 20rpx;
}

.sec-count {
  margin-left: 14rpx;
  font-size: 23rpx;
  font-weight: 400;
  color: #93A19C;
}

.sec-empty {
  font-size: 24rpx;
  color: #93A19C;
}

.cat {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F1F5F4;
}

.cat:last-child {
  border-bottom: none;
}

.cat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cat-name {
  font-size: 28rpx;
  color: #1B211F;
  font-weight: 500;
}

.cat-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #14453D;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.cat-samples {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7C8B86;
  line-height: 1.6;
}

.hit {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F1F5F4;
}

.hit:last-child {
  border-bottom: none;
}

.hit-head {
  display: flex;
  align-items: center;
}

.hit-text {
  font-size: 29rpx;
  font-weight: 600;
  color: #1B211F;
  margin-right: 14rpx;
}

.hit-kind {
  margin-left: auto;
  font-size: 22rpx;
  color: #93A19C;
}

.hit-reason {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #5E6E69;
  line-height: 1.6;
}

.hit-sug {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #1F6F5C;
}

.good-card {
  background: #E7F0ED;
  box-shadow: none;
}

.good-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #14453D;
}

.good-body {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #3F6157;
  line-height: 1.7;
}

.good-note {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #6E8B82;
  line-height: 1.6;
}

/* ---------- 原文 ---------- */
.legend {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #EDF1F0;
  margin-bottom: 22rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 28rpx;
  font-size: 23rpx;
  color: #7C8B86;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.dot-high { background: #FBD9D5; }
.dot-medium { background: #FBE7C6; }
.dot-low { background: #DDEDE7; }

.origin-text {
  font-size: 30rpx;
  line-height: 1.9;
  color: #232A28;
  word-break: break-word;
}

.origin-tip {
  padding: 0 12rpx 20rpx;
  font-size: 23rpx;
  color: #93A19C;
  line-height: 1.6;
}
