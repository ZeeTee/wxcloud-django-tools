<!-- pages/result/result.wxml -->
<view class="page page-bottom">

  <!-- 记录找不到 -->
  <view class="card" wx:if="{{missing}}">
    <view class="t-h2">没找到这条记录</view>
    <view class="t-sub">它可能已经被删掉了，或者本地存储被清理过。</view>
    <view class="gap-16"></view>
    <button class="btn btn-primary" bindtap="onBackHome">回到首页，重新来一次</button>
  </view>

  <block wx:if="{{!missing}}">

    <!-- 顶部概览 -->
    <view class="card head-card">
      <view class="donut" style="--p:{{score}}%;--c:{{scoreColor}}">
        <view class="donut-hole">
          <view class="donut-num" style="color:{{scoreColor}}">{{score}}</view>
          <view class="donut-unit">分</view>
        </view>
      </view>
      <view class="head-info">
        <view class="head-chips">
          <view class="chip {{levelChip}}">AI 味{{levelText}}</view>
          <view class="chip chip-brand">{{modeText}}</view>
        </view>
        <view class="head-verdict">{{verdict}}</view>
        <view class="head-meta">命中 {{totalHits}} 处 · {{charCount}} 字 · {{createdAtText}}</view>
      </view>
    </view>

    <!-- Tab -->
    <view class="tabs">
      <view class="tab {{tab === 'result' ? 'tab-on' : ''}}" data-tab="result" bindtap="onTab">改写后</view>
      <view class="tab {{tab === 'report' ? 'tab-on' : ''}}" data-tab="report" bindtap="onTab">体检报告</view>
      <view class="tab {{tab === 'origin' ? 'tab-on' : ''}}" data-tab="origin" bindtap="onTab">原文</view>
    </view>

    <!-- ============ Tab 1：改写后 ============ -->
    <block wx:if="{{tab === 'result'}}">

      <!-- 进行中 -->
      <view class="card progress-card" wx:if="{{showProgress}}">
        <view class="progress-head">
          <view class="pulse"></view>
          <view class="progress-title">正在重写，通常 10-30 秒</view>
        </view>
        <view class="progress-sub">{{progressText}} 已等待 {{elapsedSec}} 秒</view>
        <view class="skeleton">
          <view class="sk-line"></view>
          <view class="sk-line sk-90"></view>
          <view class="sk-line sk-75"></view>
          <view class="sk-line sk-85"></view>
          <view class="sk-line sk-60"></view>
        </view>
        <view class="progress-note">可以先看下面的规则版结果，不用干等。</view>
      </view>

      <!-- 失败 -->
      <view class="card error-card" wx:if="{{showError}}">
        <view class="error-title">AI 改写没成功</view>
        <view class="error-body">{{errorText}}</view>
        <view class="error-note">下面的规则版结果是立刻就能用的，先拿它顶上。</view>
        <view class="error-ops">
          <button class="btn btn-mini btn-primary" bindtap="onRetry">{{retryLabel}}</button>
          <view class="error-about" wx:if="{{quotaBlocked}}" bindtap="onAbout">看次数说明 ›</view>
        </view>
      </view>

      <!-- AI 版 / 规则版 对照切换 -->
      <view class="switch" wx:if="{{hasLlm}}">
        <view class="switch-item {{variant === 'llm' ? 'switch-on' : ''}}" data-variant="llm" bindtap="onVariant">AI 改写版</view>
        <view class="switch-item {{variant === 'rules' ? 'switch-on' : ''}}" data-variant="rules" bindtap="onVariant">规则版</view>
      </view>

      <!-- 正文 -->
      <view class="card text-card" wx:if="{{displayText}}">
        <view class="text-head">
          <view class="text-label">{{displayLabel}}</view>
          <view class="text-head-right">
            <text class="text-count">{{displayCount}} 字</text>
            <view class="copy-mini" bindtap="onCopy">复制</view>
          </view>
        </view>
        <view class="text-body">{{displayText}}</view>
      </view>
      <view class="empty" wx:else>这里还没有内容</view>

      <!-- 操作 -->
      <view class="action-bar">
        <button class="btn btn-primary" bindtap="onCopy">复制{{displayLabel}}</button>
        <block wx:if="{{canUpgrade}}">
          <view class="gap-16"></view>
          <button class="btn btn-line" bindtap="onUpgrade">再让 AI 深度改写一遍</button>
        </block>
      </view>
      <view class="action-tip" wx:if="{{canUpgrade}}">规则版只处理套话词；AI 版会重写句子结构，通常 10-30 秒。</view>
    </block>

    <!-- ============ Tab 2：体检报告 ============ -->
    <block wx:if="{{tab === 'report'}}">

      <block wx:if="{{hasHits}}">
        <view class="card verdict-card" wx:if="{{detailVerdict}}">
          <view class="verdict-text">{{detailVerdict}}</view>
        </view>

        <view class="card" wx:if="{{hasAdvice}}">
          <view class="sec-title">怎么改</view>
          <view class="advice-item" wx:for="{{advice}}" wx:key="*this">{{item}}</view>
        </view>

        <view class="card">
          <view class="sec-title">按类别聚合</view>
          <block wx:if="{{hasCategories}}">
            <view class="cat" wx:for="{{categories}}" wx:key="key">
              <view class="cat-head">
                <view class="cat-name">{{item.name}}</view>
                <view class="cat-count">{{item.count}}</view>
              </view>
              <view class="cat-samples" wx:if="{{item.hasSamples}}">{{item.samplesText}}</view>
            </view>
          </block>
          <view class="sec-empty" wx:else>后端没返回分类，直接看下面的逐条明细。</view>
        </view>

        <view class="card">
          <view class="sec-title">逐条明细<text class="sec-count">共 {{totalHits}} 处</text></view>
          <view class="hit" wx:for="{{hits}}" wx:key="key">
            <view class="hit-head">
              <text class="hit-text">{{item.text}}</text>
              <text class="chip {{item.chip}}">{{item.severityText}}</text>
              <text class="hit-kind">{{item.kindText}}</text>
            </view>
            <view class="hit-reason">{{item.reason}}</view>
            <view class="hit-sug" wx:if="{{item.hasSuggestion}}">建议换成：{{item.suggestion}}</view>
          </view>
        </view>
      </block>

      <view class="card good-card" wx:else>
        <view class="good-title">这篇挺像人写的</view>
        <view class="good-body">没检出套话连接词、空转铺垫、排比拔高这些典型 AI 痕迹。AI 味 {{score}} 分，属于{{levelText}}。</view>
        <view class="good-note">保险起见，还是可以自己念一遍：念着别扭的地方，多半就是该改的地方。</view>
      </view>
    </block>

    <!-- ============ Tab 3：原文 ============ -->
    <block wx:if="{{tab === 'origin'}}">
      <view class="card">
        <view class="legend">
          <view class="legend-item"><view class="legend-dot dot-high"></view><text>严重</text></view>
          <view class="legend-item"><view class="legend-dot dot-medium"></view><text>中度</text></view>
          <view class="legend-item"><view class="legend-dot dot-low"></view><text>轻微</text></view>
        </view>
        <view class="origin-text"><block wx:for="{{segments}}" wx:key="key"><text wx:if="{{item.hit}}" class="hl {{item.block}}">{{item.text}}</text><text wx:else>{{item.text}}</text></block></view>
      </view>
      <view class="origin-tip" wx:if="{{hasHits}}">高亮处就是这次体检命中的位置，切到「体检报告」看每一处的处理建议。</view>
      <view class="origin-tip" wx:else>没有需要高亮的地方。</view>
    </block>

  </block>
</view>
